# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# CORS settings for Web Frontend (AI Studio, React, Next.js, Vite)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL by default, set USE_SQLITE=True for lightweight SQLite dev)
USE_SQLITE=False
DB_NAME=selfe_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# JWT (optional; defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=

# Google Gemini (official google-genai SDK)
# Create a key in Google AI Studio. Keep the free-tier model unless you have
# explicitly verified billing implications. AI endpoints fail closed if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.5

# Per-user AI request limit (DRF rate format)
AI_THROTTLE_RATE=30/hour

# Demo seed password (development only; never use in production)
DEMO_PASSWORD=DemoPass123!
